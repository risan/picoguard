# Modifiers: important, dnstype, denyallow, content types, third-party, domain, match-case,
# unsupported (client, ctag, dnsrewrite, respgeo) and unknown modifiers.
[main]
||imp.example^$important
||dt-a.example^$dnstype=A
||dt-multi.example^$dnstype=A|AAAA
||dt-not-a.example^$dnstype=~A
||dt-not-multi.example^$dnstype=~A|~AAAA
||dt-mixed.example^$dnstype=A|~AAAA
||dt-lower.example^$dnstype=a
||dt-txt.example^$dnstype=TXT
||dt-https.example^$dnstype=HTTPS
||dt-cname.example^$dnstype=CNAME
||dt-bad.example^$dnstype=NOTATYPE
||dt-empty.example^$dnstype=
||dt-none.example^$dnstype=NONE
||dt-any.example^$dnstype=ANY
||dt-imp.example^$dnstype=A,important
@@||dt-allow.example^$dnstype=AAAA
||dt-allow.example^
||deny.example^$denyallow=ok.deny.example|fine.deny.example
||deny-one.example^$denyallow=deny-one.example
||deny-sub.example^$denyallow=sub.deny-sub.example
||deny-upper.example^$denyallow=Deny-Upper.example
||deny-both.example^$denyallow=a.example,dnstype=A
||deny-empty.example^$denyallow=
||deny-neg.example^$denyallow=~a.example
||ct-script.example^$script
||ct-nscript.example^$~script
||ct-doc.example^$document
||ct-image.example^$image
||ct-nimage.example^$~image,~script
||ct-both.example^$script,~image
||ct-sub.example^$subdocument
||ct-xhr.example^$xmlhttprequest
||ct-other.example^$other
@@||ct-allow-script.example^$script
||ct-allow-script.example^
@@||ct-allow-nscript.example^$~script
||ct-allow-nscript.example^
||tp.example^$third-party
||ntp.example^$~third-party
||fp.example^$first-party
||nfp.example^$~first-party
||dom.example^$domain=a.example
||ndom.example^$domain=~a.example
||mc.example^$match-case
||nmc.example^$~match-case
||MC-upper.example^$match-case
||client.example^$client=127.0.0.1
||nclient.example^$client=~192.168.0.1
||ctag.example^$ctag=device_phone
||nctag.example^$ctag=~device_phone
||rewrite.example^$dnsrewrite=1.2.3.4
||rewrite-cname.example^$dnsrewrite=other.example
||rewrite-bad.example^$dnsrewrite=NOTAKEYWORD
@@||rewrite-allow.example^$dnsrewrite
||respgeo.example^$respgeo=us
||unknown.example^$nosuchmodifier
||unknown2.example^$important,nosuchmodifier
||popup.example^$popup
||empty.example^$empty
||mp4.example^$mp4
||redirect.example^$redirect=noopjs
||cookie.example^$cookie
||csp.example^$csp=script-src 'none'
||replace.example^$replace=/a/b/
||stealth.example^$stealth
@@||stealth.example^$stealth
||elemhide.example^$elemhide
@@||elemhide2.example^$elemhide
||elemhide2.example^
@@||urlblock.example^$urlblock
||urlblock.example^
@@||doc-allow.example^$document
||doc-allow.example^
||empty-opts.example^$
||comma-opts.example^$,important
||dup.example^$important,important
||esc-comma.example^$denyallow=a.example\,b.example
||esc-dollar\$sign.example^
||dollar.example^$important$
||ext.example^$extension
@@||ext.example^$extension
